# Example environment for LLM providers (Phase 1+)
# Copy to .env and fill in. Never commit real secrets.
#
# Preferred knobs:
#   TADS_LLM_PROVIDER  — which backend (ollama | openai | anthropic | gemini | mock)
#   TADS_MODEL         — model id for that backend
# Alias also accepted: TADS_PROVIDER (same as TADS_LLM_PROVIDER)

# ---------------------------------------------------------------------------
# Default: Ollama Cloud (recommended free tier)
# https://ollama.com/search?c=cloud
# ---------------------------------------------------------------------------
# OLLAMA_HOST defaults to https://ollama.com when unset.
# For a local daemon instead: OLLAMA_HOST=http://127.0.0.1:11434
TADS_LLM_PROVIDER=ollama
OLLAMA_API_KEY=
# Optional; default cloud model is gpt-oss:120b (free-tier friendly).
# Larger cloud models (e.g. deepseek-v4-flash:cloud) may require a subscription.
# TADS_MODEL=gpt-oss:120b
# TADS_MODEL=deepseek-v4-flash:cloud

# ---------------------------------------------------------------------------
# OpenAI example
# ---------------------------------------------------------------------------
# TADS_LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# TADS_MODEL=gpt-4.1-mini
# TADS_MODEL=gpt-4.1
# TADS_MODEL=o4-mini

# ---------------------------------------------------------------------------
# Anthropic example
# ---------------------------------------------------------------------------
# TADS_LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# TADS_MODEL=claude-sonnet-4-5

# ---------------------------------------------------------------------------
# Google Gemini example
# ---------------------------------------------------------------------------
# Prefer: import GCP project into AI Studio, enable Generative Language API,
# create the key in AI Studio for that project (prepaid credits required).
# TADS_LLM_PROVIDER=gemini
# GOOGLE_API_KEY=
# # or: GEMINI_API_KEY=
# TADS_MODEL=gemini-3.6-flash
# # Alternatives: gemini-3.5-flash, gemini-flash-latest
# # Note: gemini-2.5-flash is blocked for many new API keys.

# Optional spend caps
# TADS_MAX_COST_USD=1.00

# HTTP resilience (useful for Ollama Cloud / WSL)
# TADS_HTTP_TIMEOUT=600
# TADS_HTTP_CONNECT_TIMEOUT=90
# TADS_HTTP_WRITE_TIMEOUT=180
# TADS_HTTP_RETRIES=3

# Ingest (URL/local docx/pdf/zip)
# TADS_MAX_DOWNLOAD_MB=100
