# Example environment for LLM providers (Phase 1+)
# Copy to .env and fill in. Never commit real secrets.

# OpenAI
# OPENAI_API_KEY=

# Anthropic
# ANTHROPIC_API_KEY=

# Google Gemini
# GOOGLE_API_KEY=
# GEMINI_API_KEY=

# Cloud Ollama
# OLLAMA_HOST=https://ollama.com
# OLLAMA_API_KEY=
# TADS_MODEL=gpt-oss:120b

# Optional defaults
# TADS_PROVIDER=openai
# TADS_MODEL=gpt-4.1-mini
# TADS_MAX_COST_USD=1.00

# HTTP resilience (useful for Ollama Cloud / WSL)
# TADS_HTTP_TIMEOUT=600
# TADS_HTTP_CONNECT_TIMEOUT=90
# TADS_HTTP_WRITE_TIMEOUT=180
# TADS_HTTP_RETRIES=3
